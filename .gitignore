__pycache__/
*.pyc
.cache/
.DS_Store
.env
.env.*

.venv/

# V3: reproducible intermediate/composite copies; native exports remain in the
# standalone lossless viewer and PMDO ZIP. Keep approved sources and core layers.
/sprites/cote_v3_0812/*/AVANT_ROCHE.png
/sprites/cote_v3_0812/*/jour_*.png
/sprites/cote_v3_0812/*/nuit_*.png

# Native Abyss correction: PNG copies regenerate from pinned native sheets and
# approved masks; final pixels are embedded losslessly in the viewer/native ZIP.
/sprites/cote_v4_abyss/*/*.png

# New expedition PNGs are reproducible; final pixels are in the lossless viewer
# and native mod ZIP. Keep native masks and placement metadata in Git.
/sprites/cote_v5_expeditions/*/0[0-5]_*.png
/sprites/cote_v5_expeditions/*/TERRAIN.png
/sprites/cote_v5_expeditions/*/jour_*.png
/sprites/cote_v5_expeditions/*/nuit_*.png

# Beach V1: these duplicate exports remain byte-exact inside BeachNetwork_pack.zip.
# restore_exports.py extracts them on demand before verify/package. The viewer
# uses the preserved PNG layers and lossless WebP atlases, not these copies.
/renders/beach_network_v1/*/jour/animation/**/*.png
/renders/beach_network_v1/*/nuit/animation/**/*.png
/renders/beach_network_v1/*/jour/*.ora
/renders/beach_network_v1/*/nuit/*.ora
# Flat V1 composition copies are likewise preserved in the same archive.
/renders/beach_network_v1/*/jour/composition.png
/renders/beach_network_v1/*/nuit/composition.png
# Optional full-size PNG decoding; atlases remain the authoritative saved data.
/renders/beach_extension_v2/export_png/

# Casino: bare terrain is regenerated losslessly from the retained corrected raw.
/renders/casino_network_v1/terrain_vide.webp
/renders/casino_network_v1/export_png/

# V5 placement audit: exact PNG exports regenerate from retained V4 reference.
/renders/cafe_spinda_revisite_v5/audit/exports/

# Superseded V4 studies: exact bytes retained at the recorded historical Git commit.
/renders/cafe_spinda_reseau_v4/bruts/accueil.webp
/renders/cafe_spinda_reseau_v4/bruts/cafe.webp
/renders/cafe_spinda_reseau_v4/bruts/cafe_spinda_fidele.webp
/renders/cafe_spinda_reseau_v4/bruts/casino.webp
/renders/cafe_spinda_reseau_v4/bruts/salon_bas.webp
/renders/cafe_spinda_reseau_v4/bruts/salon_haut.webp
/renders/cafe_spinda_reseau_v4/bruts/salon_haut_spinda_fidele.webp

# Full-resolution originals archived bit-exactly in reachable Git history.
/source/cafe_spinda_revisite_v7/raws/north_corrected.webp
/source/cafe_spinda_revisite_v7/raws/kirlia_counter.webp
/source/cafe_spinda_revisite_v7/raws/alcremie_counter.webp
/source/cafe_spinda_revisite_v7/raws/kirlia_bench.webp
/source/cafe_spinda_revisite_v7/raws/alcremie_trolley.webp
/renders/cafe_spinda_revisite_v6/bruts/fenetre_cafe.webp
/source/cafe_spinda_revisite_v7/raws/kirlia_counter_front.webp
/source/cafe_spinda_revisite_v7/raws/alcremie_counter_front.webp
